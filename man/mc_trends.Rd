# one taxon with a trend, one without
m <- matrix(rnorm(2 * nrow(meta)), nrow = 2,
            dimnames = list(c("Rising", "Flat"), meta$sample))
m["Rising", ] <- m["Rising", ] + 0.8 * meta$time
